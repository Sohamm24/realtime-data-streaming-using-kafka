# ==============================================================================
# Environment Configuration for realtime-orders-streaming
# ==============================================================================

# Kafka Configuration
KAFKA_BROKER_INTERNAL=kafka:29092
KAFKA_BROKER_EXTERNAL=localhost:9092
KAFKA_TOPIC=orders
KAFKA_PARTITIONS=3

# Producer Configuration
EVENT_RATE=10
LATE_EVENT_PCT=0.05
DUPLICATE_EVENT_PCT=0.03
MALFORMED_EVENT_PCT=0.01

# Spark & Streaming Configuration
SPARK_MASTER=local[2]
SPARK_DRIVER_MEMORY=2g
WATERMARK_DURATION=2 minutes
WINDOW_DURATION=1 minute

# Storage Paths (Local mounts standing in for S3/ADLS)
DATA_DIR=./data
CHECKPOINT_DIR=./data/checkpoints
DELTA_AGG_DIR=./data/delta/orders_agg
DELTA_CLEAN_DIR=./data/delta/orders_clean
DEAD_LETTER_DIR=./data/dead_letter
